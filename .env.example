# WebToApp — example environment configuration.
# Copy to `.env` and fill in as needed. Every variable is OPTIONAL; sensible
# defaults apply when unset. Do NOT commit your real `.env`.

# ---------- Public URL ----------
# Public origin of this server (e.g. https://app.example.com). Used as the iOS
# Web Clip launcher target so the app's URL can be hot-swapped later without
# reinstalling. If unset, it is inferred from the request Host header
# (fine for local dev, but iPhones can't open "localhost").
PUBLIC_BASE_URL=

# ---------- Android build ----------
# Default Android package prefix; the per-app id is appended automatically.
ANDROID_PACKAGE_PREFIX=com.webtoapp
# Directory holding per-app signing keystores (one cert per app). Keep this
# OUTSIDE any publicly served path. Defaults to certs/app-keys.
ANDROID_KEYSTORE_DIR=
# Password for the internal template-build keystore only (not security
# critical — the template is re-signed per app). Defaults to "android".
ANDROID_TEMPLATE_KEYSTORE_PASSWORD=
# Android SDK location (usually auto-detected). Set if build tools aren't found.
ANDROID_HOME=
ANDROID_SDK_ROOT=

# ---------- Build quota / abuse control ----------
# Per device-fingerprint daily build limit. 0 disables the quota.
DAILY_BUILD_QUOTA=10

# ---------- iOS .mobileconfig signing (optional) ----------
# Provide a public-CA SSL cert to sign Web Clip profiles so iOS shows your
# domain instead of "Unsigned". You can also drop files into certs/ as
# ios-cert.pem / ios-key.pem / ios-chain.pem instead of setting these.
IOS_CERT_FILE=
IOS_KEY_FILE=
IOS_CHAIN_FILE=

# ---------- Cloudflare R2 offload (optional) ----------
# Set ALL of these to mirror download artifacts to R2 and 302-redirect
# downloads to the CDN, saving origin bandwidth.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ---------- Cloudflare cache purge (optional) ----------
# When set, changing an app's target URL eagerly purges the cached redirect.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Seconds the iOS /launch 302 may be cached at the edge (lower = faster swap).
LAUNCH_CACHE_MAX_AGE=60
